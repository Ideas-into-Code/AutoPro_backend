# Copier ce fichier en .env et renseigner de vraies valeurs. Ne jamais committer .env.
# Depuis #26 (QA & sécurisation API), les secrets n'ont plus de valeur par défaut
# dans application.properties : l'application ne démarre pas sans eux.

# Base de données
DB_URL=jdbc:postgresql://localhost:5432/autopro
DB_USERNAME=autopro_user
DB_PASSWORD=

# Port HTTP (défaut : 8080)
PORT=8080

# Générer avec : openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# CORS : origines du frontend autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

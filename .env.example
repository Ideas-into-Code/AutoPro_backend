# Copier ce fichier en .env et renseigner de vraies valeurs. Ne jamais committer .env.
# Depuis #26 (QA & sécurisation API), ces variables n'ont plus de valeur par défaut
# dans application.properties : l'application ne démarre pas sans elles.

DB_USERNAME=autopro_user
DB_PASSWORD=

# Générer avec : openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
